# Docker container overrides (gitignored — never commit).
# Copy to `.env.docker` and uncomment what you need. Networking vars
# (DATABASE_URL, REDIS_URL, …) live in docker-compose.yml — edit them there.

# --- Django ---
# SECRET_KEY=change-me-in-production
# DEBUG=False
# ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0
# WEB_PORT=8000
# RUN_MIGRATIONS=auto

# --- JWT ---
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7

# --- Google (Gmail) login ---
# GOOGLE_CLIENT_ID=
