# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# --- Database ---
# PostgreSQL-ready. Examples:
# SQLite (local default, no server required):
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production / full local stack):
# DATABASE_URL=postgres://foodflow:foodflow@localhost:5432/foodflow
DATABASE_URL=sqlite:///db.sqlite3

# --- Redis (ready, not required to boot) ---
# Example: REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Celery (ready, no worker required to boot) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- JWT (SimpleJWT lifetimes) ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Google (Gmail) login ---
# Web client ID from Google Cloud Console (APIs & Services > Credentials).
# Required for POST /api/v1/auth/google/. Empty = endpoint returns 400.
GOOGLE_CLIENT_ID=

# --- Email (placeholder) ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@foodflow.local

# --- Docker ---
# Containers do NOT read this file. Networking vars (DATABASE_URL, REDIS_URL,
# …) are hardcoded in docker-compose.yml so this localhost-oriented file can
# never break them. To override container env (SECRET_KEY, GOOGLE_CLIENT_ID,
# …), copy .env.docker.example to .env.docker (gitignored).
